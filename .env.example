# Client-side (exposed to the browser, safe to publish)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Server-side (SSR + server functions). Same values, no VITE_ prefix.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>
SUPABASE_PROJECT_ID=<project-ref>

# Only needed for privileged server-side operations (never expose to the browser)
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Optional: force a server build target when the host is not auto-detected
# (node_server | bun | deno_server | vercel | netlify | cloudflare_pages | cloudflare_module)
# NITRO_PRESET=node_server

# Set to "true" only after enabling the Google provider in Supabase Auth
VITE_ENABLE_GOOGLE_AUTH=false
